# ==========================================================
# MedSest Visita — variáveis de ambiente de PRODUÇÃO (EXEMPLO)
# Copie para .env no servidor e preencha com valores reais.
# NUNCA versione o .env com valores reais.
# ==========================================================

# --- Banco de dados (PostgreSQL local no VPS) ---
# Troque SENHA_FORTE por uma senha real e forte.
DATABASE_URL=postgresql+asyncpg://medsest_user:SENHA_FORTE@localhost:5432/medsest_db

# --- Segurança / JWT ---
# GERE uma chave nova: openssl rand -hex 32
SECRET_KEY=COLE_AQUI_UMA_CHAVE_DE_64_HEX
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Uploads (fora do diretório do código, para não sumir no redeploy) ---
UPLOAD_DIR=/var/www/medsest/uploads
MAX_FILE_SIZE_MB=10

# --- URL pública do app ---
APP_BASE_URL=https://app.medsest.com.br

# --- E-mail (SMTP) — preencher quando as credenciais chegarem ---
# Enquanto vazio, as notificações são registradas como FALHOU (sem quebrar nada).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=MedSest Visita

# WhatsApp (Twilio): descartado por ora — deixar em branco.

# --- Ambiente ---
# ⚠️ ENVIRONMENT=production LIGA o cookie de refresh como `secure` (só via HTTPS).
# Sem isso, a sessão não se mantém em produção.
ENVIRONMENT=production
DEBUG=false
CORS_ORIGINS=["https://app.medsest.com.br"]
